{
  "name": "abac-auth",
  "version": "0.1.0",
  "description": "Reusable Attribute-Based Access Control (ABAC) system in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && sed -i 's/\\.ts\"/\\.js\"/g' dist/*.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --typecheck run"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "hono": "^4.13.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
