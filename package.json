{
  "name": "abac-auth",
  "version": "0.1.0",
  "description": "Reusable Attribute-Based Access Control (ABAC) system in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && sed -i 's/\\.ts\"/\\.js\"/g' dist/*.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --typecheck run"
  },
  "devDependencies": {
    "@types/node": "^28.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
